{
  "version": 1,
  "description": "Chính sách API Gateway cho Hệ thống Quản lý Chấm công - Tính lương & Nhân sự (HTQLNS)",
  "cors": {
    "origins": ["*"],
    "allowedHeaders": ["Authorization", "Content-Type", "x-request-id", "x-internal-key"],
    "allowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
  },
  "limits": {
    "bodyBytes": 10485760,
    "global": {
      "windowMs": 60000,
      "max": 1000
    }
  },
  "routes": [
    {
      "prefix": "/api/auth/login",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["POST"],
          "auth": false,
          "rateLimit": {
            "windowMs": 60000,
            "max": 15
          }
        }
      ]
    },
    {
      "prefix": "/api/auth/register",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["POST"],
          "auth": false,
          "rateLimit": {
            "windowMs": 60000,
            "max": 10
          }
        }
      ]
    },
    {
      "prefix": "/api/auth/refresh",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["POST"],
          "auth": false
        }
      ]
    },
    {
      "prefix": "/api/auth/forgot-password",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["POST"],
          "auth": false,
          "rateLimit": {
            "windowMs": 60000,
            "max": 5
          }
        }
      ]
    },
    {
      "prefix": "/api/auth/reset-password",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["POST"],
          "auth": false
        }
      ]
    },
    {
      "prefix": "/api/auth/me",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["GET", "PUT"],
          "auth": true,
          "roles": ["*"]
        }
      ]
    },
    {
      "prefix": "/api/auth/change-password",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["POST"],
          "auth": true,
          "roles": ["*"]
        }
      ]
    },
    {
      "prefix": "/api/auth/users",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["GET"],
          "auth": true,
          "roles": ["ADMIN", "HR"]
        },
        {
          "methods": ["PUT", "DELETE"],
          "auth": true,
          "roles": ["ADMIN"]
        }
      ]
    },
    {
      "prefix": "/api/auth",
      "service": "auth-service",
      "rules": [
        {
          "methods": ["*"],
          "auth": true,
          "roles": ["*"]
        }
      ]
    },
    {
      "prefix": "/api/organization/departments",
      "service": "organization-service",
      "rules": [
        {
          "methods": ["GET"],
          "auth": true,
          "roles": ["*"]
        },
        {
          "methods": ["POST", "PUT", "DELETE"],
          "auth": true,
          "roles": ["ADMIN", "HR"]
        }
      ]
    },
    {
      "prefix": "/api/organization/positions",
