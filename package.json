{
  "name": "htqlns-main",
  "version": "1.0.0",
  "description": "Hệ thống Quản lý Chấm công - Tính lương & Nhân sự (HTQLNS) – Kiến trúc Hướng Dịch Vụ (SOA) với Express.js",
  "main": "scripts/run-all.js",
  "scripts": {
    "start": "node scripts/run-all.js",
    "test": "node --test tests/infra.test.js tests/auth-org.test.js",
    "test:infra": "node --test tests/infra.test.js",
    "test:auth-org": "node --test tests/auth-org.test.js",
    "start:gateway": "node gateway/server.js",
    "start:registry": "node registry/server.js",
    "start:event-bus": "node event-bus/server.js",
    "start:auth": "node services/auth-service/index.js",
    "start:organization": "node services/organization-service/index.js",
    "start:attendance": "node services/attendance-service/index.js",
    "start:leave": "node services/leave-service/index.js",
    "start:shift": "node services/shift-service/index.js",
    "start:payroll": "node services/payroll-service/index.js",
    "start:notification": "node services/notification-service/index.js",
    "start:analytics": "node services/analytics-service/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "mysql2": "^3.24.4"
  }
}
